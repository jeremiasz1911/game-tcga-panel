// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username      String   @db.VarChar(255)
  email         String   @unique(map: "users_email_unique") @db.VarChar(255)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)
  gamesAsPlayerA Game[]  @relation("games_player_a")
  gamesAsPlayerB Game[]  @relation("games_player_b")

  @@map("users")
}

model Game {
  id             String    @id @db.VarChar(255)
  state          String?   @db.Text
  playerAPayload String?   @map("player_a_payload") @db.Text
  playerBPayload String?   @map("player_b_payload") @db.Text
  playerAId      BigInt    @map("player_a_id") @db.UnsignedBigInt
  playerBId      BigInt    @map("player_b_id") @db.UnsignedBigInt
  finished       Boolean   @default(false) @db.TinyInt
  rulesOverride  String?   @map("rules_override") @db.LongText
  botWorking     Boolean   @default(false) @map("bot_working") @db.TinyInt
  createdAt      DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(0)
  playerA        User      @relation("games_player_a", fields: [playerAId], references: [id])
  playerB        User      @relation("games_player_b", fields: [playerBId], references: [id])

  @@index([playerAId], map: "games_player_a_id_foreign")
  @@index([playerBId], map: "games_player_b_id_foreign")
  @@index([finished], map: "games_finished_idx")
  @@map("games")
}
